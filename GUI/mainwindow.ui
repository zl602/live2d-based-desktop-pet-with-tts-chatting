  <property name="styleSheet">
   <string notr="true">/* ---------------- 全局基础样式 ---------------- */
* {
    /* 像素风字体（需将&quot;PixelMplus12-Regular.ttf&quot;放到项目目录，或替换为系统字体） */
    font-family: &quot;PixelMplus12&quot;, &quot;微软雅黑&quot;, &quot;SimHei&quot;, sans-serif;
    font-size: 12px;
	font-weight: bold;
}

QWidget {
    background-color: #0A0A1A; /* 暗黑赛博背景 */
    color: #FFFFFF; /* 默认文字白色 */
}

/* ---------------- 窗口样式 ---------------- */
QMainWindow, QWidget#main_window {
    background-color: #0A0A1A;
    border: 2px solid #FF2E9F; /* 粉色霓虹边框 */
}

/* 透明窗口适配（Live2D窗口） */
QWidget#live2d_window {
    background-color: transparent;
    border: none;
}

/* ---------------- 按钮样式（核心） ---------------- */
QPushButton {
    /* 粉蓝渐变背景（Qt标准渐变写法） */
    background: transparent;
    color: #ffffff; /* 文字白色对比 */
    font-size: 14px;
    font-weight: bold;
    border-width: 2px; /* 必须设置边框宽度 */
    border-style: solid; /* 边框样式 */
    border-color: #FF2E9F #00E5FF #00E5FF #FF2E9F;
    border-radius: 4px; /* 轻微圆角（像素风避免大圆角） */
    padding: 6px 12px; /* 按钮内边距（初始值） */
}

QPushButton:hover {
    background: #696969; /*  hover背景 */
    padding-left: 9px;
    padding-top: 7px;
    /* 强化发光 */
    text-shadow: 0 0 8px #FFFFFF;
}

QPushButton:pressed {

    background: #696969; 
    border-color: #ffffff;
    padding-left: 10px;
    padding-top: 9px;
}

QPushButton:disabled {
    background: #333344;
    color: #888888;
    border-color: #666666;
    text-shadow: none;
}

/* ---------------- 文本浏览器（QTextBrowser） ---------------- */
QTextBrowser {
    background-color: #121228;
    color: #00E5FF; /* 霓虹蓝文字 */
    border: 1px solid #9D00FF; /* 紫色边框 */
    padding: 8px;
    /* 像素风文字 */
    font-size: 12px;
    /* 轻微文字发光 */
    text-shadow: 0 0 3px #00E5FF;
}

/* ---------------- 标签（QLabel） ---------------- */
QLabel {
    color: #FFFFFF;
}

/* 标题标签 */
QLabel#title_label {
    font-size: 18px;
    font-weight: bold;
    /* Qt渐变文字写法（模拟，需结合透明背景） */
    color: #FF2E9F;
    text-shadow: 0 0 6px #FF2E9F, 0 0 10px #9D00FF;
}

/* 普通文本标签 */
QLabel#normal_label {
    color: #FFD1DC; /* 浅粉色文字 */
    text-shadow: 0 0 2px #FF2E9F;
}

/* ---------------- 分隔线（QFrame） ---------------- */
QFrame::HLine { /* Qt标准HLine选择器 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    height: 2px;
    border: none;
}

/* ---------------- 输入框（QLineEdit） ---------------- */
QLineEdit {
    background-color: #121228;
    color: #00E5FF;
    border: 2px solid #FF2E9F;
    padding: 6px;
    text-shadow: 0 0 3px #00E5FF;
}

QLineEdit:focus {
    border-color: #00E5FF;
    outline: none;
}

/* ---------------- 下拉框 ComboBox（带边框） ---------------- */
QComboBox {
    background-color: #333344; /* 控件底色 */
    border: 2px solid #333344; /* 合并边框属性（宽度+样式+颜色） */
    border-radius: 2px;
    padding: 4px;
    color: #FFFFFF;
}

/* ComboBox 下拉列表 */
QComboBox QAbstractItemView {
    background-color: #121228;
    border: 2px solid #ff2e9f; /* 粉色列表边框 */
    selection-background-color: #ff2e9f; /* 选中项背景 */
    selection-color: #0a0a1a;
    padding: 4px;
}

/* ComboBox 下拉箭头 */
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: url(:/icons/arrow_down.png); /* 可选：替换箭头图标，若无则用默认 */
    width: 10px;
    height: 10px;
}

QFrame[frameShape=&quot;4&quot;] { /* HLine水平分隔线 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    height: 2px;
    border: none;
}

/* 全局Horizontal Slider轨道样式 */
QSlider::horizontal {
    /* 轨道高度（横线粗细） */
    height: 10px;
    /* 轨道背景：水平渐变（保持原渐变效果） */
    background: #696969;
    /* 轨道圆角，让横线更圆润 */
    border-radius: 1px;
    /* 内边距，避免滑块与轨道边缘重叠 */
    padding: 0px;
}

/* 滑块样式（核心：黑色、圆形、适配轨道） */
QSlider::handle:horizontal {
    /* 滑块大小（宽高一致做成圆形） */
    width: 16px;
    height: 16px;
    /* 滑块背景：纯黑色 */
    background: #000000;
    /* 圆形滑块（圆角设为宽高的一半） */
    border-radius: 8px;
    /* 滑块阴影（可选，增加立体感） */
    border: 1px solid #cccccc;
    /* 滑块居中（相对于轨道） */
    margin: -5px 0px -5px 0px;
}

/* 滑块hover状态（可选，鼠标悬浮时加深） */
QSlider::handle:horizontal:hover {
    background: #222222;
}

/* 已拖动部分的轨道（可选，区分进度） */
QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    border-radius: 3px;
}

/* ---------------- 标签页 TabWidget 样式 ---------------- */
QTabWidget {
    background-color: #0A0A1A; /* 匹配全局暗黑背景 */
	border-color: 
   
}

/* 标签栏整体（顶部显示） */
QTabWidget::tab-bar {
    alignment: left; /* 标签左对齐（可选：center 居中/right 右对齐） */
    margin-left: 4px; /* 标签栏左侧留白，像素风轻微偏移 */
}

/* 单个标签（未选中状态） */
QTabBar::tab {
    background-color: #121228; /* 深色底色 */
    color: #FFFFFF; /* 浅粉色文字，匹配normal_label */
    border: 2px solid #FF2E9F; /* 粉色边框，匹配按钮初始边框 */
    border-bottom: none; /* 取消底部边框，避免与内容区重叠 */
    border-top-left-radius: 4px; /* 轻微圆角，像素风不做大圆角 */
    border-top-right-radius: 4px;
    padding: 6px 16px; /* 标签内边距，保证点击区域 */
    margin-right: 2px; /* 标签之间的间距 */
    font-weight: bold; /* 匹配全局粗体 */
    text-shadow: 0 0 2px #FF2E9F; /* 轻微霓虹发光 */
}

/* 标签 hover 状态（鼠标悬浮） */
QTabBar::tab:hover {
    background-color: #333344; /* 匹配ComboBox底色 */
    color: #FFFFFF; /* 文字变白 */
    text-shadow: 0 0 8px #FFFFFF; /* 强化发光，匹配按钮hover */
}

/* 标签选中状态（核心） */
QTabBar::tab:selected {
    background-color: #0A0A1A; /* 匹配窗口背景，视觉融合 */
    color: #00E5FF; /* 霓虹蓝文字，匹配TextBrowser */
    border-color: #00E5FF; /* 切换为蓝色边框，突出选中态 */
    border-bottom: 2px solid #0A0A1A; /* 覆盖内容区边框，避免双重线 */
    text-shadow: 0 0 6px #00E5FF; /* 蓝色霓虹发光 */
}



/* TabWidget 内容区（标签对应的页面） */
QTabWidget::pane {
    background-color: #0A0A1A; /* 匹配全局背景 */
    border: 1px solid #000000; /* 粉色边框，匹配窗口边框 */
    top: -2px; /* 上移2px，与选中标签的底部无缝衔接 */
    padding: 8px; /* 内容区内边距，避免内容贴边 */
}

/* 隐藏标签页右侧的滚动按钮（可选，像素风简化界面） */
QTabBar::scroll-button {
    width: 0;
    height: 0;
    border: none;
}</string>
