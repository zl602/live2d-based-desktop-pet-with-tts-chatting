  <property name="styleSheet">
   <string notr="true">
/* ---------------- 全局基础样式 ---------------- */
* {
    /* 像素风字体（需将&quot;PixelMplus12-Regular.ttf&quot;放到项目目录，或替换为系统字体） */
    font-family: &quot;PixelMplus12&quot;, &quot;微软雅黑&quot;, &quot;SimHei&quot;, sans-serif;
    font-size: 12px;
	font-weight: bold;
}

QWidget {
    background-color: #0A0A1A; /* 暗黑赛博背景 */
    color: #FFFFFF; /* 默认文字白色 */
}

/* ---------------- 窗口样式 ---------------- */
QMainWindow, QWidget#main_window {
    background-color: #0A0A1A;
    border: 2px solid #FF2E9F; /* 粉色霓虹边框 */
}

/* 透明窗口适配（Live2D窗口） */
QWidget#live2d_window {
    background-color: transparent;
    border: none;
}

/* ---------------- 按钮样式（核心） ---------------- */
QPushButton {
    /* 粉蓝渐变背景 */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #FF2E9F, stop:1 #00E5FF);
    color: #0A0A1A; /* 文字深色对比 */
    font-size: 14px;
    font-weight: bold;
    border: 2px solid #FFFFFF; /* 白色像素边框 */
    border-radius: 4px; /* 轻微圆角（像素风避免大圆角） */
    padding: 8px 16px;
    /* 霓虹发光效果 */
    text-shadow: 0 0 5px #FFFFFF;
}

QPushButton:hover {
    /* 悬停时加深渐变 */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #FF55B8, stop:1 #2DE2FF);
    /* 故障偏移效果 */
    padding-left: 9px;
    padding-top: 7px;
    /* 强化发光 */
    text-shadow: 0 0 8px #FFFFFF;
}

QPushButton:pressed {
    /* 按下时反向渐变 */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #00E5FF, stop:1 #FF2E9F);
    /* 按压偏移 */
    padding-left: 10px;
    padding-top: 9px;
}

QPushButton:disabled {
    background: #333344;
    color: #888888;
    border-color: #666666;
    text-shadow: none;
}

/* ---------------- 文本浏览器（QTextBrowser） ---------------- */
QTextBrowser {
    background-color: #121228;
    color: #00E5FF; /* 霓虹蓝文字 */
    border: 1px solid #9D00FF; /* 紫色边框 */
    padding: 8px;
    /* 像素风文字 */
    font-size: 12px;
    /* 轻微文字发光 */
    text-shadow: 0 0 3px #00E5FF;
}

/* ---------------- 标签（QLabel） ---------------- */
QLabel {
    color: #FFFFFF;
}

/* 标题标签 */
QLabel#title_label {
    font-size: 18px;
    font-weight: bold;
    /* 粉紫渐变文字 */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                stop:0 #FF2E9F, stop:1 #9D00FF);
    -webkit-background-clip: text;
    color: transparent;
    text-shadow: 0 0 6px #FF2E9F;
}

/* 普通文本标签 */
QLabel#normal_label {
    color: #FFD1DC; /* 浅粉色文字 */
    text-shadow: 0 0 2px #FF2E9F;
}

/* ---------------- 分隔线（QFrame） ---------------- */
QFrame[frameShape=&quot;4&quot;] { /* HLine水平分隔线 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    height: 2px;
    border: none;
}

/* ---------------- 输入框（QLineEdit） ---------------- */
QLineEdit {
    background-color: #121228;
    color: #00E5FF;
    border: 2px solid #FF2E9F;
    padding: 6px;
    text-shadow: 0 0 3px #00E5FF;
}

QLineEdit:focus {
    border-color: #00E5FF;
    outline: none;
}



/* ---------------- 下拉框 ComboBox（带边框） ---------------- */
QComboBox {
    background-color: #333344; /* 控件底色 */
    border-color: #333344；
    border-radius: 2px;

}
/* ComboBox 下拉列表 */
QComboBox QAbstractItemView {
    background-color: #121228;
    border: 2px solid #ff2e9f; /* 粉色列表边框 */
    selection-background-color: #ff2e9f; /* 选中项背景 */
    selection-color: #0a0a1a;
}
/* ---------------- 全局基础样式 ---------------- */
* {
    /* 像素风字体（需将&quot;PixelMplus12-Regular.ttf&quot;放到项目目录，或替换为系统字体） */
    font-family: &quot;PixelMplus12&quot;, &quot;微软雅黑&quot;, &quot;SimHei&quot;, sans-serif;
    font-size: 12px;
}

QWidget {
    background-color: #0A0A1A; /* 暗黑赛博背景 */
    color: #FFFFFF; /* 默认文字白色 */
}

/* ---------------- 窗口样式 ---------------- */
QMainWindow, QWidget#main_window {
    background-color: #0A0A1A;
    border: 2px solid #FF2E9F; /* 粉色霓虹边框 */
}

/* 透明窗口适配（Live2D窗口） */
QWidget#live2d_window {
    background-color: transparent;
    border: none;
}

/* ---------------- 按钮样式（核心） ---------------- */
QPushButton {
    /* 粉蓝渐变背景（Qt标准渐变写法） */
    background: transparent;
    color: #ffffff; /* 文字白色对比 */
    font-size: 14px;
    font-weight: bold;
    border-width: 2px; /* 必须设置边框宽度 */
    border-style: solid; /* 边框样式 */
    border-color: #FF2E9F #00E5FF #00E5FF #FF2E9F;
    border-radius: 4px; /* 轻微圆角（像素风避免大圆角） */
    padding: 6px 12px; /* 按钮内边距（初始值） */
}

QPushButton:hover {
    background: #696969; /*  hover背景 */
    padding-left: 9px;
    padding-top: 7px;
    /* 强化发光 */
    text-shadow: 0 0 8px #FFFFFF;
}

QPushButton:pressed {

    background: #696969; 
    border-color: #ffffff;
    padding-left: 10px;
    padding-top: 9px;
}

QPushButton:disabled {
    background: #333344;
    color: #888888;
    border-color: #666666;
    text-shadow: none;
}

/* ---------------- 文本浏览器（QTextBrowser） ---------------- */
QTextBrowser {
    background-color: #121228;
    color: #00E5FF; /* 霓虹蓝文字 */
    border: 1px solid #9D00FF; /* 紫色边框 */
    padding: 8px;
    /* 像素风文字 */
    font-size: 12px;
    /* 轻微文字发光 */
    text-shadow: 0 0 3px #00E5FF;
}

/* ---------------- 标签（QLabel） ---------------- */
QLabel {
    color: #FFFFFF;
}

/* 标题标签 */
QLabel#title_label {
    font-size: 18px;
    font-weight: bold;
    /* Qt渐变文字写法（模拟，需结合透明背景） */
    color: #FF2E9F;
    text-shadow: 0 0 6px #FF2E9F, 0 0 10px #9D00FF;
}

/* 普通文本标签 */
QLabel#normal_label {
    color: #FFD1DC; /* 浅粉色文字 */
    text-shadow: 0 0 2px #FF2E9F;
}

/* ---------------- 分隔线（QFrame） ---------------- */
QFrame::HLine { /* Qt标准HLine选择器 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    height: 2px;
    border: none;
}

/* ---------------- 输入框（QLineEdit） ---------------- */
QLineEdit {
    background-color: #121228;
    color: #00E5FF;
    border: 2px solid #FF2E9F;
    padding: 6px;
    text-shadow: 0 0 3px #00E5FF;
}

QLineEdit:focus {
    border-color: #00E5FF;
    outline: none;
}

/* ---------------- 下拉框 ComboBox（带边框） ---------------- */
QComboBox {
    background-color: #333344; /* 控件底色 */
    border: 2px solid #333344; /* 合并边框属性（宽度+样式+颜色） */
    border-radius: 2px;
    padding: 4px;
    color: #FFFFFF;
}

/* ComboBox 下拉列表 */
QComboBox QAbstractItemView {
    background-color: #121228;
    border: 2px solid #ff2e9f; /* 粉色列表边框 */
    selection-background-color: #ff2e9f; /* 选中项背景 */
    selection-color: #0a0a1a;
    padding: 4px;
}

/* ComboBox 下拉箭头 */
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: url(:/icons/arrow_down.png); /* 可选：替换箭头图标，若无则用默认 */
    width: 10px;
    height: 10px;
}

QFrame[frameShape=&quot;4&quot;] { /* HLine水平分隔线 */
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, 
                                     stop:0 #FF2E9F, stop:1 #00E5FF);
    height: 2px;
    border: none;
}</string>
